# Shared editor settings. Also read by shfmt and prettier; keep consistent with
# ruff.toml, taplo.toml, .prettierrc.json and rustfmt.toml.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs}]
indent_size = 4

[*.sh]
indent_size = 2
switch_case_indent = true

[*.md]
# Markdown is not auto-formatted (decision 0012): keep trailing double spaces.
trim_trailing_whitespace = false

[justfile]
indent_size = 4
