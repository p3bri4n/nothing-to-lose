{
  "model": "opusplan",
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(just tf-apply:*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin master)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:master)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * HEAD:master)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * refs/heads/master)",
      "Bash(git push * *:main)",
      "Bash(git push * *:master)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push * *:refs/heads/master)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/format_on_edit.py\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/guard_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
